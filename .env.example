# Copy to .env and adjust. .env is gitignored and must never be committed.

# --- Database ---
# Matches docker-compose.yml. Change nothing for local development.
DATABASE_URL=postgresql+psycopg://scrapr:scrapr_local_dev_only@localhost:5432/scrapr

# --- Runtime ---
SCRAPR_ENV=local
LOG_LEVEL=INFO

# Origins allowed to call the API with credentials. Explicit, never a wildcard:
# the session cookie is the whole authorization story.
WEB_ORIGINS=http://localhost:3000

# Read the client address for rate limiting from X-Forwarded-For. Set true only
# behind a proxy that sets it (Vercel does). Left false, a client could name a
# new address on every request and never be limited.
# TRUST_PROXY_HEADERS=false

# In production (SCRAPR_ENV=production) the API and worker refuse to start
# unless DATABASE_URL has sslmode=require (or stricter), STORAGE_ENDPOINT_URL
# and every WEB_ORIGINS entry are https://, and none of the development
# credentials above are in use (REQ-SEC-003, REQ-SEC-007 AC-3).

# --- AI provider (DEC-06, closing OPEN-04) ---
# Without this the worker runs a deterministic stand-in locally and REFUSES to
# start in production. The stand-in rearranges retrieved text and writes no
# research of its own, which is why it must never reach users.
ANTHROPIC_API_KEY=

# The DEC-06 tier table. Defaults shown; override to change which model serves
# a tier without touching a stage.
# SCRAPR_MODEL_CHEAP=claude-haiku-4-5
# SCRAPR_MODEL_STANDARD=claude-sonnet-5
# SCRAPR_MODEL_DEEP=claude-opus-5

# --- Data providers (DEC-07, closing OPEN-05..09) ---
# Each is optional. A missing key means that category does not register and the
# run reports it as a named gap - degraded and stated, never silent.

# Web search (OPEN-05) AND news (OPEN-09): one key serves both categories, so
# one absent key removes both. See DEC-07 section 8.
TAVILY_API_KEY=

# Financial and stock data (OPEN-06)
FMP_API_KEY=

# Job postings (OPEN-08) - both halves required
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Regulatory filings (OPEN-07). SEC EDGAR needs NO API KEY. It requires a
# descriptive User-Agent with contact details and refuses requests without one,
# so this string is what gates the filings category. Put a real address here.
# SEC_EDGAR_USER_AGENT=ScrapR/0.1 (you@example.com)

# --- Operating limits (DEC-23..25, closing OPEN-18, OPEN-23, OPEN-29) ---
# TBD-10 and TBD-11: the most one run may spend, in millionths of a dollar.
# RUN_COST_CEILING_MICROS=2000000
# UPDATE_COST_CEILING_MICROS=1500000
# TBD-13: pending runs beyond which new research is refused with 503.
# QUEUE_SHED_THRESHOLD=100
# Research repeats its progress line after this many silent seconds (TBD-05 is 30).
# ACTIVITY_HEARTBEAT_SECONDS=20

# --- Retrieval cache (DEC-19, closing OPEN-26) ---
# How long an identical retrieval is reused within ONE run. The cache never
# outlives its run, so Update Research always re-fetches.
# RETRIEVAL_CACHE_TTL_SECONDS=900

# --- Object storage (DEC-12, closing OPEN-10) ---
# The S3 API is the contract. MinIO locally, Cloudflare R2 in production; the
# client is identical and only these five values differ.
#
# Every default below matches docker-compose.yml, and the compose stack creates
# the bucket and sets it private on first start. Change nothing for local
# development.
# STORAGE_ENDPOINT_URL=http://localhost:9000
# STORAGE_BUCKET=scrapr-uploads
# STORAGE_ACCESS_KEY=scrapr
# STORAGE_SECRET_KEY=scrapr_local_dev_only
# STORAGE_REGION=auto
#
# For R2: the account endpoint, an R2 access key pair, and region "auto".
# For real AWS S3: leave STORAGE_ENDPOINT_URL empty and set the bucket's actual
# region.

# --- Upload limits (DEC-13, closing OPEN-19) ---
# Enforced server-side twice: at presign against the declared size, and again
# at completion against the size the object actually has.
# MAX_UPLOAD_BYTES=26214400          # 25 MB per file
# MAX_UPLOADS_PER_SESSION=10
# MAX_SESSION_UPLOAD_BYTES=104857600 # 100 MB per research session
