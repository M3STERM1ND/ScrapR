# Normalize line endings on commit, check out LF everywhere.
# Without this the repo grew a CRLF-converted duplicate of the landing page
# at root src/ alongside the real one in web/. See Phase 0 restructure.
* text=auto eol=lf

# Binary: never touch these.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.avif  binary
*.pdf   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary

# Generated: keep out of diffs and language stats.
package-lock.json  linguist-generated=true -diff
uv.lock            linguist-generated=true -diff
packages/contracts/openapi.json  linguist-generated=true -diff
