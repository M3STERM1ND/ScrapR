          "seq": {
            "title": "Seq",
            "type": "integer"
          }
        },
        "required": [
          "id",
          "seq",
          "role",
          "content",
          "claim_type",
          "evidence_ids",
          "created_at"
        ],
        "title": "MessageOut",
        "type": "object"
      },
      "MessageRole": {
        "description": "Author of a conversation message (`REQ-CONV-007`).",
        "enum": [
          "user",
          "agent"
        ],
        "title": "MessageRole",
        "type": "string"
      },
      "ResearchSessionOut": {
        "description": "The session header the workspace renders around (`REQ-WORK-002`).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
