{
  "components": {
    "schemas": {
      "ActivityEventOut": {
        "description": "One timeline entry. User-facing text only (`REQ-ACT-003`).",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "seq": {
            "title": "Seq",
            "type": "integer"
          },
          "status": {
            "$ref": "#/components/schemas/ActivityStatus"
          },
          "tool_category": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Tool Category"
          }
        },
        "required": [
          "seq",
          "label",
          "status",
          "tool_category",
          "created_at"
        ],
        "title": "ActivityEventOut",
        "type": "object"
      },
      "ActivityPage": {
        "description": "Events after a sequence number, plus where to resume from.\n\n`next_after` is what the client sends back, so the polling loop never has to\nreason about timestamps \u2014 and the Phase 3 SSE upgrade resumes from exactly\nthe same value (implementation plan \u00a76.3).",
        "properties": {
          "events": {
            "items": {
              "$ref": "#/components/schemas/ActivityEventOut"
            },
            "title": "Events",
            "type": "array"
          },
          "next_after": {
            "title": "Next After",
            "type": "integer"
          }
        },
        "required": [
          "events",
          "next_after"
        ],
        "title": "ActivityPage",
        "type": "object"
      },
      "ActivityStatus": {
        "description": "Per-event status in the activity timeline (`REQ-ACT-004 AC-2`).",
        "enum": [
          "in_progress",
          "complete",
          "failed"
        ],
        "title": "ActivityStatus",
        "type": "string"
      },
      "AskIn": {
        "description": "A follow-up question.",
        "properties": {
          "context_ref": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Ref"
          },
          "question": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Question",
            "type": "string"
          }
        },
        "required": [
          "question"
        ],
        "title": "AskIn",
        "type": "object"
      },
      "AskOut": {
        "description": "The turn pair a question produces.",
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/MessageOut"
          },
          "question": {
            "$ref": "#/components/schemas/MessageOut"
          },
          "researched": {
            "title": "Researched",
            "type": "boolean"
          }
        },
        "required": [
          "question",
          "answer",
          "researched"
        ],
        "title": "AskOut",
        "type": "object"
      },
      "AuthorityTier": {
        "description": "Source authority (`REQ-EVID-002`). Assignment rules are `OPEN-15`.",
        "enum": [
          "primary",
          "secondary",
          "lower"
        ],
        "title": "AuthorityTier",
        "type": "string"
      },
      "ClaimOut": {
        "description": "One assertion, typed, with the sources behind it (`REQ-SYNTH-002..003`).",
        "properties": {
          "claim_type": {
            "$ref": "#/components/schemas/ClaimType"
          },
          "confidence": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence"
          },
          "confidence_rationale": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Confidence Rationale"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/EvidenceOut"
            },
            "title": "Evidence",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_important": {
            "title": "Is Important",
            "type": "boolean"
          },
          "reporting_period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporting Period"
          },
          "source_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Source Ids",
            "type": "array"
          },
          "text": {
            "title": "Text",
            "type": "string"
          }
        },
        "required": [
          "id",
          "text",
          "claim_type",
          "confidence",
          "confidence_rationale",
          "reporting_period",
          "is_important",
          "source_ids",
          "evidence"
        ],
        "title": "ClaimOut",
        "type": "object"
      },
      "ClaimType": {
        "description": "Claim taxonomy (`REQ-SYNTH-002`).\n\nThe gate in `REQ-EVID-017 AC-1` is scoped to `FACT`, and\n`REQ-SYNTH-009` requires assumptions on `FORECAST`, so these two values are\nload-bearing rather than descriptive.",
        "enum": [
          "fact",
          "analysis",
          "forecast",
          "uncertainty"
        ],
        "title": "ClaimType",
        "type": "string"
      },
      "ConflictCause": {
        "description": "Why two pieces of evidence disagree (`REQ-EVID-013 AC-1`).",
        "enum": [
          "period",
          "definition",
          "currency",
          "estimate_vs_reported",
          "methodology",
          "staleness"
        ],
        "title": "ConflictCause",
        "type": "string"
      },
      "ConflictOut": {
        "description": "Evidence that disagrees, surfaced rather than resolved away.\n\n`REQ-WORK-009`: conflicts are a visible feature of the report, not hidden.\n`explanation` is null when nothing in the evidence accounts for the gap,\nand `status` then reads `unresolved` \u2014 `REQ-EVID-013 AC-3` forbids\ninventing a cause, and `REQ-EVID-014` requires saying so plainly.",
        "properties": {
          "claim_id": {
            "format": "uuid",
            "title": "Claim Id",
            "type": "string"
          },
          "explanation": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Explanation"
          },
          "explanation_category": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ConflictCause"
              },
              {
                "type": "null"
              }
            ]
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "sides": {
            "items": {
              "$ref": "#/components/schemas/ConflictSideOut"
            },
            "title": "Sides",
            "type": "array"
          },
          "status": {
            "$ref": "#/components/schemas/ConflictStatus"
          }
        },
        "required": [
          "id",
          "claim_id",
          "status",
          "explanation",
          "explanation_category",
          "sides"
        ],
        "title": "ConflictOut",
        "type": "object"
      },
      "ConflictSideOut": {
        "description": "One value in a disagreement, with what a reader needs to judge it.\n\n`REQ-EVID-012 AC-3` names the three: the source, its tier, and when it was\nread. Showing the values without them would present a disagreement the\nreader has no way to weigh.",
        "properties": {
          "evidence_id": {
            "format": "uuid",
            "title": "Evidence Id",
            "type": "string"
          },
          "label": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Label"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "value": {
            "title": "Value",
            "type": "string"
          }
        },
        "required": [
          "evidence_id",
          "source_id",
          "label",
          "value"
        ],
        "title": "ConflictSideOut",
        "type": "object"
      },
      "ConflictStatus": {
        "description": "Whether a conflict was explained or is surfaced unresolved (`REQ-EVID-014`).",
        "enum": [
          "explained",
          "unresolved"
        ],
        "title": "ConflictStatus",
        "type": "string"
      },
      "CreateResearchRequest": {
        "description": "`REQ-INPUT-001..005`. Only the objective is required.",
        "properties": {
          "context_company": {
            "anyOf": [
              {
                "maxLength": 200,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Company"
          },
          "context_ticker": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Ticker"
          },
          "context_url": {
            "anyOf": [
              {
                "maxLength": 2048,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context Url"
          },
          "instructions": {
            "anyOf": [
              {
                "maxLength": 2000,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Instructions"
          },
          "objective": {
            "maxLength": 2000,
            "minLength": 10,
            "title": "Objective",
            "type": "string"
          }
        },
        "required": [
          "objective"
        ],
        "title": "CreateResearchRequest",
        "type": "object"
      },
      "CreateResearchResponse": {
        "description": "202: the work is accepted, not finished (`REQ-AGENT-008 AC-1`).",
        "properties": {
          "session_id": {
            "format": "uuid",
            "title": "Session Id",
            "type": "string"
          },
          "version_id": {
            "format": "uuid",
            "title": "Version Id",
            "type": "string"
          },
          "version_number": {
            "title": "Version Number",
            "type": "integer"
          }
        },
        "required": [
          "session_id",
          "version_id",
          "version_number"
        ],
        "title": "CreateResearchResponse",
        "type": "object"
      },
      "EvidenceOut": {
        "description": "One piece of evidence behind a claim, as the inspector shows it.\n\n`REQ-EVID-019 AC-1` names what inspection must show, and \"the relevant\nevidence\" is the item the payload did not carry: source, tier and retrieval\ntime were all reachable through `source_ids`, but the *excerpt* \u2014 the words\nthe source actually printed \u2014 existed only in the database.\n\nThat excerpt is the whole point of the citation surface. A reader checking\na claim is checking it against what was written, not against a link.",
        "properties": {
          "excerpt": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Excerpt"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "reporting_period": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Reporting Period"
          },
          "source_id": {
            "format": "uuid",
            "title": "Source Id",
            "type": "string"
          },
          "statement": {
            "title": "Statement",
            "type": "string"
          },
          "value_raw": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value Raw"
          }
        },
        "required": [
          "id",
          "source_id",
          "statement",
          "excerpt",
          "value_raw",
          "reporting_period"
        ],
        "title": "EvidenceOut",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "MessageOut": {
        "description": "One conversation turn (`REQ-CONV-007`).",
        "properties": {
          "claim_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ClaimType"
              },
              {
                "type": "null"
              }
            ]
          },
          "content": {
            "title": "Content",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "evidence_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Evidence Ids",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/MessageRole"
