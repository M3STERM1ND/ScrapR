      "SourceOut": {
        "description": "Where a claim's evidence came from, and when it was read.\n\n`retrieved_at` is on the wire because `REQ-EVID-004` makes it part of what\nthe user is entitled to see, not internal bookkeeping.",
        "properties": {
          "authority_tier": {
            "$ref": "#/components/schemas/AuthorityTier"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "published_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Published At"
          },
          "publisher": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Publisher"
          },
          "retrieved_at": {
            "format": "date-time",
            "title": "Retrieved At",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Url"
          }
        },
        "required": [
          "id",
          "name",
          "url",
          "publisher",
          "authority_tier",
          "retrieved_at",
          "published_at"
        ],
        "title": "SourceOut",
        "type": "object"
      },
      "ValidationError": {
