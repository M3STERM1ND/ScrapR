  "info": {
    "description": "Turns a question into an evidence-backed report with sources, analysis, charts and follow-up.",
    "title": "ScrapR",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
