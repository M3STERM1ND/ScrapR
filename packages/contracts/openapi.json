      },
      "SectionOut": {
        "description": "A report section and the claims it renders.",
        "properties": {
          "claim_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "title": "Claim Ids",
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "is_executive_summary": {
            "title": "Is Executive Summary",
            "type": "boolean"
          },
          "ordering": {
            "title": "Ordering",
